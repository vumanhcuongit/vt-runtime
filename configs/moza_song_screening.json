{
  "vt": "moza",
  "workflow": "song_screening",
  "item_id_field": "song_id",
  "steps": [
    {"name": "fetch", "type": "deterministic", "source": "fixtures/songs.json"},
    {"name": "rights_check", "type": "deterministic", "lookup": "fixtures/rights.json", "on_unknown": "stop"},
    {"name": "judge", "type": "model", "prompt": "prompts/teaching_suitability.txt", "outcomes": ["include", "exclude", "needs_review"]},
    {"name": "create_task", "type": "external", "target": "review_system", "operation": "create_task", "approval": "auto", "idempotent": true}
  ]
}
